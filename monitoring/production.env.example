# Save a filled copy as .env.monitoring in the repository root (ignored by Git).
PUBLIC_SITE_URL=
PUBLIC_API_URL=
# Read-only API key: GET Uptime Monitors + GET Contact Lists.
HETRIXTOOLS_API_KEY=
# A dedicated monitoring bot and your private/group chat; keep separate from customer requests.
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_TELEGRAM_CHAT_ID=
SENTRY_ORG=
SENTRY_PROJECT=
# User auth token with event:read, separate from the source-map upload token.
SENTRY_READ_TOKEN=
# Match the Sentry data region: https://sentry.io, https://us.sentry.io or https://de.sentry.io.
SENTRY_API_ORIGIN=https://sentry.io
# On the host: absolute path to app/shared/monitoring, outside release directories.
MONITOR_STATE_DIR=
# Private URL from a HetrixTools Cron Job monitor (5-minute timeout).
MONITOR_HEARTBEAT_URL=
# Used only for source map uploads during CI; never add a PUBLIC_ or VITE_ prefix.
SENTRY_AUTH_TOKEN=
