---
import type { ContactDetailsDto } from '@/entities/site';
import type { SocialLinkDto } from '@/entities/social-link';
import type { FaqItemDto } from '@/entities/faq';
import { Contact } from '@/widgets/contact';
import { Faq } from '@/widgets/faq';
import { routes } from '@/shared/routes';
interface Props {
  contacts: ContactDetailsDto;
  socials: SocialLinkDto[];
  faq: FaqItemDto[];
}
const { contacts, socials, faq } = Astro.props;
const profiles = socials.filter((item) => item.url);
const hasDetails = Boolean(
  contacts.email || contacts.phone || contacts.address || profiles.length,
);
---

<section
  class="contacts-header page-container"
  aria-labelledby="contacts-page-title"
>
  <nav class="breadcrumb" aria-label="Хлебные крошки">
    <a href={routes.home}>Главная</a><span aria-hidden="true">/</span><span
      aria-current="page">Контакты</span
    >
  </nav>
  <p class="eyebrow">Контакты</p>
  <h1 id="contacts-page-title">Будем<br />на связи.</h1>
  <p class="contacts-description">
    Можно прийти с вопросом, с несколькими идеями или пока без точной
    формулировки. Выбери удобный способ связи — начнём с бесплатного знакомства.
  </p>
</section>
<Contact socials={socials} telegramUrl={contacts.telegramUrl}
  ><slot name="contact-form" /></Contact
>
{
  hasDetails && (
    <section
      class="contact-details page-container"
      aria-labelledby="other-contacts-title"
    >
      <h2 id="other-contacts-title">Другие способы связи</h2>
      <address>
        {contacts.email && (
          <div>
            <p class="eyebrow">Электронная почта</p>
            <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
          </div>
        )}
        {contacts.phone && (
          <div>
            <p class="eyebrow">Телефон</p>
            <a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}>
              {contacts.phone}
            </a>
          </div>
        )}
        {contacts.address && (
          <div>
            <p class="eyebrow">Адрес</p>
            <p>{contacts.address}</p>
          </div>
        )}
        {profiles.length > 0 && (
          <div>
            <p class="eyebrow">Социальные сети</p>
            <ul>
              {profiles.map((item) => (
                <li>
                  <a href={item.url!} target="_blank" rel="noopener noreferrer">
                    {item.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </address>
    </section>
  )
}
<Faq items={faq} />
<style>
  .contacts-header {
    padding-block: 56px 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    font-size: 76px;
  }
  .contacts-description {
    max-width: 730px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted-foreground);
  }
  .contact-details {
    padding-block: 64px;
  }
  .contact-details h2 {
    font-size: 48px;
    margin-bottom: 32px;
  }
  address {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 64px;
    font-style: normal;
  }
  address .eyebrow {
    margin-bottom: 12px;
  }
  address a,
  address p:not(.eyebrow) {
    font-size: 17px;
    overflow-wrap: anywhere;
  }
  address a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  address ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  @media (max-width: 1100px) {
    h1 {
      font-size: 60px;
    }
  }
  @media (max-width: 767px) {
    .contacts-header,
    .contact-details {
      padding-block: 44px;
    }
    h1 {
      font-size: 52px;
    }
    .contact-details h2 {
      font-size: 36px;
    }
    address {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
