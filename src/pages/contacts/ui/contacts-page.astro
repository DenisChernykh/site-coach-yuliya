---
import { PageSections } from '@/entities/cms';
import type { CmsPageDto } from '@/shared/api';
import type { ContactDetailsDto } from '@/entities/site';
import type { SocialLinkDto } from '@/entities/social-link';
import type { FaqItemDto } from '@/entities/faq';
import { Contact } from '@/widgets/contact';
import { Faq } from '@/widgets/faq';
import { routes } from '@/shared/routes';
interface Props {
  layouts?: CmsPageDto[];
  preview?: boolean;
  contacts: ContactDetailsDto;
  socials: SocialLinkDto[];
  faq: FaqItemDto[];
}
const { layouts, preview = false, contacts, socials, faq } = Astro.props;
const profiles = socials.filter((item) => item.url);
const hasDetails = Boolean(
  contacts.email || contacts.phone || contacts.address || profiles.length,
);
---

<PageSections pageKey="contacts" layouts={layouts} preview={preview}>
  <Fragment slot="hero">
    <section
      class="contacts-header page-container"
      aria-labelledby="contacts-page-title"
    >
      <nav class="breadcrumb" aria-label="Хлебные крошки">
        <a href={routes.home}>Главная</a><span aria-hidden="true">/</span><span
          aria-current="page">Контакты</span
        >
      </nav>
      <h1 id="contacts-page-title" data-cms-copy="title">Контакты</h1>
      <p class="contacts-description" data-cms-copy="description">
        Напиши в Telegram или оставь заявку на бесплатную встречу. Обсудим твою
        ситуацию и уточним, с чем ты хочешь поработать.
      </p>
    </section>
  </Fragment>
  <Fragment slot="contact">
    <Contact
      preview={preview}
      socials={socials}
      telegramUrl={contacts.telegramUrl}><slot name="contact-form" /></Contact
    >
  </Fragment>
  <Fragment slot="details">
    {
      hasDetails && (
        <section
          class="contact-details page-container"
          aria-labelledby="other-contacts-title"
        >
          <h2 id="other-contacts-title" data-cms-copy="title">
            Другие способы связи
          </h2>
          <address>
            {contacts.email && (
              <div>
                <p class="eyebrow" data-cms-copy="eyebrow">
                  Электронная почта
                </p>
                <a
                  href={`mailto:${contacts.email}`}
                  data-cms-field="contacts.email"
                  data-cms-field="contacts.email"
                >
                  {contacts.email}
                </a>
              </div>
            )}
            {contacts.phone && (
              <div>
                <p class="eyebrow">Телефон</p>
                <a
                  href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}
                  data-cms-field="contacts.phone"
                  data-cms-field="contacts.phone"
                >
                  {contacts.phone}
                </a>
              </div>
            )}
            {contacts.address && (
              <div>
                <p class="eyebrow">Адрес</p>
                <p
                  data-cms-field="contacts.address"
                  data-cms-field="contacts.address"
                >
                  {contacts.address}
                </p>
              </div>
            )}
            {profiles.length > 0 && (
              <div>
                <p class="eyebrow">Социальные сети</p>
                <ul>
                  {profiles.map((item) => (
                    <li>
                      <a
                        href={item.url!}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.label} <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </address>
        </section>
      )
    }
  </Fragment>
  <Fragment slot="faq">
    <Faq preview={preview} items={faq} />
  </Fragment>
</PageSections>
<style>
  .contacts-header {
    padding-block: 56px 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    font-size: 76px;
  }
  .contacts-description {
    max-width: 730px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted-foreground);
  }
  .contact-details {
    padding-block: 64px;
  }
  .contact-details h2 {
    font-size: 48px;
    margin-bottom: 32px;
  }
  address {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 64px;
    font-style: normal;
  }
  address .eyebrow {
    margin-bottom: 12px;
  }
  address a,
  address p:not(.eyebrow) {
    font-size: 17px;
    overflow-wrap: anywhere;
  }
  address a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  address ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  @media (max-width: 1100px) {
    h1 {
      font-size: 60px;
    }
  }
  @media (max-width: 767px) {
    .contacts-header,
    .contact-details {
      padding-block: 44px;
    }
    h1 {
      font-size: 52px;
    }
    .contact-details h2 {
      font-size: 36px;
    }
    address {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
