---
import { PageSections } from '@/entities/cms';
import { Stories } from '@/widgets/stories';
import type { CmsPageDto } from '@/shared/api';
import { Image } from 'astro:assets';
import type { HomePageDto } from '@/entities/site';
import type { ServiceDto } from '@/entities/service';
import type { FaqItemDto } from '@/entities/faq';
import type { SocialLinkDto } from '@/entities/social-link';
import { ArticleCard, type ArticleDto } from '@/entities/article';
import { CaseStudies } from '@/widgets/case-studies';
import { Pricing } from '@/widgets/pricing';
import { WorkProcess } from '@/widgets/work-process';
import { WorkBoundaries } from '@/widgets/work-boundaries';
import { Faq } from '@/widgets/faq';
import { Contact } from '@/widgets/contact';
import { portrait, art } from '@/shared/assets';
import { routes } from '@/shared/routes';
import { buttonVariants } from '@/shared/ui';
import { ArrowUpRight } from 'lucide-react';
interface Props {
  layouts?: CmsPageDto[];
  preview?: boolean;
  data: HomePageDto;
  telegramUrl?: string | null;
  services: ServiceDto[];
  faq: FaqItemDto[];
  socials: SocialLinkDto[];
  articles: ArticleDto[];
}
const {
  layouts,
  telegramUrl,
  preview = false,
  data,
  services,
  faq,
  socials,
  articles,
} = Astro.props;
---

<PageSections pageKey="home" layouts={layouts} preview={preview}>
  <Fragment slot="hero">
    <section class="hero" aria-labelledby="hero-title">
      <div class="page-container hero-grid">
        <div class="hero-content">
          <p
            class="eyebrow"
            data-cms-field="home.hero.eyebrow"
            data-cms-copy="eyebrow"
          >
            {data.hero.eyebrow}
          </p>
          <h1
            id="hero-title"
            data-cms-list="home.hero.headingLines"
            data-cms-last-class="italic-line"
          >
            {
              data.hero.headingLines.map((line, index) => (
                <span
                  data-cms-item
                  data-cms-value
                  class:list={[
                    index === data.hero.headingLines.length - 1 &&
                      'italic-line',
                  ]}
                >
                  {line}
                </span>
              ))
            }
          </h1>
          <p
            class="hero-description"
            data-cms-field="home.hero.description"
            data-cms-copy="description"
          >
            {data.hero.description}
          </p>
          <div class="hero-actions">
            <a href="#contact" class:list={[buttonVariants(), 'hero-cta']}
              >Записаться на встречу <ArrowUpRight
                size={18}
                aria-hidden="true"
              /></a
            >
            <a href={routes.coaching} class="text-link"
              >Индивидуальный коучинг <span aria-hidden="true">↗</span></a
            >
          </div>
          <p class="meeting-note" data-cms-field="home.hero.meetingNote">
            {data.hero.meetingNote}
          </p>
        </div>
        <figure class="hero-figure">
          <div class="hero-media">
            <Image
              src={portrait}
              alt="Демонстрационный портрет для макета сайта Юли Валишиной"
              width={1040}
              height={1212}
              format="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption>
            Демонстрационный AI-портрет · заменить фото Юли
          </figcaption>
        </figure>
      </div>
    </section>
  </Fragment>
  <Fragment slot="stories">
    {
      Astro.slots.has('stories') ? (
        <slot name="stories" />
      ) : (
        (preview ||
          data.stories?.some(
            (story) =>
              story.enabled && story.slides.some((slide) => slide.enabled),
          )) && (
          <section
            id="stories"
            class="section-space"
            aria-labelledby="stories-title"
          >
            <div class="page-container">
              <h2
                id="stories-title"
                class="mb-6 text-[32px] md:text-[40px]"
                data-cms-copy="title"
              >
                Сторис о моей работе
              </h2>
              {preview ? (
                <div data-cms-react="stories" />
              ) : (
                <Stories stories={data.stories ?? []} client:load />
              )}
            </div>
          </section>
        )
      )
    }
  </Fragment>
  <Fragment slot="concerns">
    <section class="concerns" aria-labelledby="concerns-title">
      <div class="page-container">
        <div class="concerns-heading">
          <h2 id="concerns-title" data-cms-copy="title">
            Как коуч я работаю с запросами
          </h2>
        </div>
        <div class="concerns-grid" data-cms-list="home.concerns">
          {
            data.concerns.map((concern) => (
              <article data-cms-item>
                <>
                  <h3 data-cms-field=".title">{concern.title}</h3>
                  <p data-cms-field=".description">{concern.description}</p>
                  <a href="#contact" class="text-link">
                    Хочу обсудить <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </Fragment>
  <Fragment slot="about">
    <section id="about" class="about" aria-labelledby="about-title">
      <div class="page-container about-grid">
        <Image
          src={portrait}
          alt="Демонстрационный портрет коуча"
          width={780}
          height={876}
          format="webp"
          loading="lazy"
        />
        <div class="about-copy" data-cms-list="home.about.paragraphs">
          <p
            class="eyebrow"
            data-cms-field="home.about.eyebrow"
            data-cms-copy="eyebrow"
          >
            {data.about.eyebrow}
          </p><h2
            id="about-title"
            data-cms-field="home.about.title"
            data-cms-copy="title"
          >
            {data.about.title}
          </h2>{
            data.about.paragraphs.map((paragraph) => (
              <p data-cms-item data-cms-value>
                {paragraph}
              </p>
            ))
          }<a href={routes.about} class="text-link"
            >Моя история и подход <span aria-hidden="true">↗</span></a
          >
          <a href={`${routes.about}#education`} class="text-link"
            >Образование и обучение <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </Fragment>
  <Fragment slot="approach">
    <section id="approach" class="approach" aria-labelledby="approach-title">
      <div class="page-container approach-grid">
        <div class="approach-copy">
          <p
            class="eyebrow"
            data-cms-field="home.approach.eyebrow"
            data-cms-copy="eyebrow"
          >
            {data.approach.eyebrow}
          </p><h2
            id="approach-title"
            data-cms-field="home.approach.title"
            data-cms-copy="title"
          >
            {data.approach.title}
          </h2><p data-cms-field="home.approach.description">
            {data.approach.description}
          </p><blockquote data-cms-field="home.approach.quote">
            {data.approach.quote}
          </blockquote>
        </div>
        <ol class="approach-steps" data-cms-list="home.approach.steps">
          {
            data.approach.steps.map((step, index) => (
              <li data-cms-item>
                <>
                  <span data-cms-index>
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <>
                      <h3 data-cms-field=".title">{step.title}</h3>
                      <p data-cms-field=".description">{step.description}</p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </Fragment>
  <Fragment slot="pricing">
    <Pricing services={services} />
  </Fragment>
  <Fragment slot="process">
    <WorkProcess steps={data.process} />
  </Fragment>
  <Fragment slot="boundaries">
    <WorkBoundaries />
  </Fragment>
  <Fragment slot="cases">
    {
      (preview || data.caseStudies.some((item) => item.enabled !== false)) && (
        <section
          id="cases"
          class="section-space cases"
          aria-labelledby="cases-title"
        >
          <div class="page-container cases-inner">
            <div class="cases-heading">
              <>
                <h2
                  id="cases-title"
                  class="section-heading"
                  data-cms-copy="title"
                >
                  Кейсы клиентов
                </h2>
                <p class="fine-print">
                  С чем обратились, что обсудили и какие решения приняли.
                </p>
              </>
            </div>
            {preview ? (
              <div data-cms-react="cases" />
            ) : (
              <CaseStudies items={data.caseStudies} client:visible />
            )}
            <p class="fine-print">
              Опыт индивидуален; одинаковый результат не гарантируется.
            </p>
          </div>
        </section>
      )
    }
  </Fragment>
  <Fragment slot="art">
    <section class="art-practice" aria-labelledby="art-title">
      <div class="page-container art-grid">
        <figure>
          <Image
            src={art}
            alt="Создание коллажа из бумаги и фотографий за светлым столом"
            width={1200}
            height={912}
            format="webp"
            loading="lazy"
          /><figcaption>
            Демонстрационный AI-снимок творческого процесса
          </figcaption>
        </figure>
        <div class="art-copy">
          <h2
            id="art-title"
            class="section-heading"
            data-cms-field="home.artPractice.title"
            data-cms-copy="title"
          >
            {data.artPractice.title}
          </h2><p data-cms-field="home.artPractice.description">
            {data.artPractice.description}
          </p><div class="art-details" data-cms-list="home.artPractice.details">
            {
              data.artPractice.details.map((detail) => (
                <p data-cms-item data-cms-value>
                  {detail}
                </p>
              ))
            }
          </div><a
            href="#contact"
            class:list={[
              buttonVariants(),
              'h-14 px-6 gap-[18px] text-sm w-fit',
            ]}
            >Узнать о следующей встрече <ArrowUpRight
              size={18}
              aria-hidden="true"
            /></a
          >
        </div>
      </div>
    </section>
  </Fragment>
  <Fragment slot="products">
    <section
      class="other-formats"
      aria-label="Групповой коучинг и самостоятельные практики"
    >
      <div class="page-container products-grid" data-cms-list="home.products">
        {
          data.products.map((product) => (
            <article data-cms-item>
              <>
                <h2 data-cms-field=".title" data-cms-copy="title">
                  {product.title}
                </h2>
                <p class="product-details" data-cms-field=".eyebrow">
                  {product.eyebrow}
                </p>
                <p data-cms-field=".description">{product.description}</p>
                <a href="#contact" class="text-link">
                  {product.actionLabel} <span aria-hidden="true">↗</span>
                </a>
              </>
            </article>
          ))
        }
      </div>
    </section>
  </Fragment>
  <Fragment slot="articles">
    <section class="journal-preview" aria-labelledby="journal-preview-title">
      <div class="page-container">
        <div class="journal-heading">
          <div>
            <h2
              id="journal-preview-title"
              class="section-heading"
              data-cms-copy="title"
            >
              Статьи
            </h2>
          </div><a href={routes.journal} class="text-link"
            >Все статьи <span aria-hidden="true">↗</span></a
          >
        </div>
        <div class="articles-grid" data-cms-react="articles">
          {
            articles
              .slice(0, 2)
              .map((article) => <ArticleCard article={article} />)
          }
        </div>
      </div>
    </section>
  </Fragment>
  <Fragment slot="faq">
    <Faq preview={preview} items={faq} />
  </Fragment>
  <Fragment slot="contact">
    <Contact preview={preview} socials={socials} telegramUrl={telegramUrl}
      ><slot name="contact-form" /></Contact
    >
  </Fragment>
</PageSections>
<style>
  .hero {
    padding-block: 64px 56px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 520px;
    gap: 68px;
    align-items: center;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: flex-start;
    animation: hero-enter 0.65s both;
  }
  h1 {
    font-size: 94px;
    line-height: 0.94;
    letter-spacing: -1.8px;
  }
  h1 span {
    display: block;
  }
  h1 .italic-line {
    font-size: 98px;
    font-style: italic;
    line-height: 1.05;
    letter-spacing: 0;
  }
  .hero-description {
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted-foreground);
    white-space: pre-line;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .hero-cta {
    height: 56px;
    padding-inline: 24px;
    gap: 18px;
    font-size: 14px;
  }
  .meeting-note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted-foreground);
  }
  .hero-figure {
    animation: hero-enter 0.85s 0.12s both;
  }
  .hero-media {
    position: relative;
    height: 606px;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .hero-media img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  figcaption {
    font-size: 10px;
    color: var(--muted-foreground);
    line-height: 1.5;
    margin-top: 12px;
  }
  .concerns {
    padding-block: 56px 80px;
  }
  .concerns-heading h2 {
    font-size: 52px;
  }
  .concerns-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px 40px;
    margin-top: 40px;
  }
  .concerns-grid article {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }
  .concerns-grid h3 {
    font-size: 32px;
    margin: 0;
  }
  .concerns-grid p {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted-foreground);
    white-space: pre-line;
  }
  .concerns-grid a {
    margin: 0;
    align-self: end;
    justify-self: start;
  }
  .about {
    padding-block: 64px;
    background: var(--secondary);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 390px minmax(0, 1fr);
    align-items: center;
    gap: 100px;
  }
  .about-grid img {
    width: 390px;
    height: 438px;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .about-copy h2 {
    font-size: 66px;
    white-space: pre-line;
  }
  .about-copy > p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.5;
  }
  .about-copy a {
    font-size: 14px;
    font-weight: 600;
  }
  .approach {
    padding-block: 80px;
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .approach-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 550px;
    gap: 104px;
    align-items: start;
  }
  .approach-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .approach-copy .eyebrow,
  .approach-copy > p:not(.eyebrow) {
    color: var(--secondary);
  }
  .approach-copy h2 {
    font-size: 64px;
    white-space: pre-line;
  }
  .approach-copy > p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.7;
  }
  blockquote {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 25px;
    line-height: 1.3;
    font-style: italic;
    color: var(--accent);
    white-space: pre-line;
  }
  .approach-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .approach-steps li {
    display: flex;
    gap: 28px;
    border-bottom: 1px solid
      color-mix(in srgb, var(--secondary) 15%, transparent);
    padding-block: 20px;
  }
  .approach-steps li > span {
    width: 28px;
    flex-shrink: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--accent);
  }
  .approach-steps h3 {
    font-size: 30px;
  }
  .approach-steps p {
    margin-top: 6px;
    font-size: 14px;
    color: var(--secondary);
    line-height: 1.5;
  }
  .cases-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .cases-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 80px;
  }
  .cases-heading .fine-print {
    width: 350px;
    flex-shrink: 0;
    font-size: 12px;
  }
  .cases-heading h2 {
    font-size: 56px;
  }
  .art-practice {
    padding-block: 72px;
    background: var(--card);
  }
  .art-grid {
    display: grid;
    grid-template-columns: minmax(0, 604fr) minmax(0, 612fr);
    gap: 64px;
    align-items: center;
  }
  .art-grid img {
    width: 100%;
    aspect-ratio: 604/448;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .art-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .art-copy h2 {
    white-space: pre-line;
  }
  .art-copy > p:not(.eyebrow, .fine-print) {
    color: var(--muted-foreground);
    font-size: 16px;
    line-height: 1.5;
  }
  .art-details {
    font-size: 13px;
    line-height: 1.5;
  }
  .other-formats {
    padding-block: 0 64px;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 56px;
  }
  .products-grid article {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .products-grid h2 {
    font-size: 34px;
  }
  .products-grid .product-details {
    font-size: 13px;
  }
  .products-grid p:not(.product-details) {
    font-size: 15px;
    color: var(--muted-foreground);
    line-height: 1.5;
  }
  .products-grid a {
    justify-self: start;
    align-self: end;
    font-weight: 600;
  }
  .journal-preview {
    padding-block: 72px;
  }
  .journal-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 36px;
  }
  .journal-heading h2 {
    font-size: 56px;
  }
  .journal-heading > a {
    font-size: 14px;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 1250px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 40px;
    }
    h1 {
      font-size: 80px;
    }
    h1 .italic-line {
      font-size: 84px;
    }
    .hero-actions {
      flex-wrap: wrap;
      gap: 16px;
    }
    .about-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 60px;
    }
    .about-grid img {
      width: 100%;
    }
  }
  @media (max-width: 1050px) {
    .hero-media {
      height: 560px;
    }
    h1 {
      font-size: 72px;
    }
    h1 .italic-line {
      font-size: 76px;
    }
    .hero-description {
      white-space: normal;
    }
    .approach-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 50px;
    }
    .approach-copy h2 {
      font-size: 52px;
    }
    .cases-heading {
      gap: 40px;
    }
    .cases-heading .fine-print {
      width: 260px;
    }
  }
  @media (max-width: 767px) {
    .hero,
    .concerns,
    .about,
    .approach,
    .art-practice,
    .journal-preview {
      padding-block: 44px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .hero-content {
      gap: 28px;
    }
    h1 {
      font-size: 60px;
      letter-spacing: -1.8px;
    }
    h1 .italic-line {
      font-size: 60px;
    }
    .hero-description {
      font-size: 17px;
    }
    .hero-actions {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .hero-cta {
      max-width: 100%;
    }
    .meeting-note {
      font-size: 12px;
    }
    .hero-media {
      height: auto;
      aspect-ratio: 342/398;
    }
    .hero-media img {
      height: 100%;
    }
    .concerns-heading h2 {
      font-size: 42px;
    }
    .concerns-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 28px;
    }
    .concerns-grid h3 {
      font-size: 32px;
    }
    .concerns-grid article {
      grid-template-rows: auto auto auto;
      grid-row: auto;
      gap: 14px;
      padding-block: 24px 0;
    }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .about-grid img {
      height: auto;
      aspect-ratio: 342/350;
    }
    .about-copy h2 {
      font-size: 42px;
    }
    .about-copy > p:not(.eyebrow) {
      font-size: 17px;
      line-height: 1.5;
    }
    .approach-grid {
      grid-template-columns: 1fr;
      gap: 28px;
