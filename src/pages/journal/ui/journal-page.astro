---
import { routes } from '@/shared/routes';
import { buttonVariants } from '@/shared/ui';
import { ArrowUpRight } from 'lucide-react';

import { PageSections } from '@/entities/cms';
import type { CmsPageDto } from '@/shared/api';
interface Props {
  layouts?: CmsPageDto[];
  preview?: boolean;
}
const { layouts, preview = false } = Astro.props;
---

<PageSections pageKey="journal" layouts={layouts} preview={preview}>
  <Fragment slot="hero">
    <section class="journal-page">
      <div class="page-container journal-header">
        <nav class="breadcrumb" aria-label="Хлебные крошки">
          <a href={routes.home}>Главная</a><span aria-hidden="true">/</span
          ><span aria-current="page">Статьи</span>
        </nav>
        <div class="journal-intro">
          <h1 data-cms-copy="title">Статьи</h1>
          <p class="journal-description" data-cms-copy="description">
            О выборе профессии, принятии решений и продвижении своих услуг.
            Вопросы и упражнения для самостоятельной работы.
          </p>
        </div>
      </div>
    </section>
  </Fragment>
  <Fragment slot="articles"><slot /></Fragment>
  <Fragment slot="cta"
    ><section class="journal-cta">
      <div class="page-container journal-cta-inner">
        <div>
          <h2 data-cms-copy="title">Запишись на бесплатную встречу</h2><p>
            30–60 минут по видеосвязи: обсудим ситуацию и уточним запрос.
          </p>
        </div><a
          href={routes.contact}
          class:list={[buttonVariants(), 'h-14 px-6 gap-[18px] text-sm']}
          >Обсудить мой запрос <ArrowUpRight size={18} aria-hidden="true" /></a
        >
      </div>
    </section>
  </Fragment>
</PageSections>
<style>
  .journal-page {
    padding-top: 56px;
  }
  .journal-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .breadcrumb {
    margin: 0;
  }
  .journal-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 500px;
    gap: 100px;
    align-items: end;
  }
  h1 {
    font-size: 76px;
    line-height: 1.06;
  }
  .journal-description {
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted-foreground);
  }
  .journal-cta {
    background: var(--secondary);
    padding-block: 56px;
  }
  .journal-cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 80px;
  }
  .journal-cta h2 {
    font-size: 48px;
  }
  .journal-cta p {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.5;
  }
  @media (max-width: 1100px) {
    .journal-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 767px) {
    .journal-page {
      padding-top: 36px;
    }
    .journal-cta {
      padding-block: 36px;
    }
    .journal-intro {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    h1 {
      font-size: 52px;
    }
    .journal-cta-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
    }
    .journal-cta h2 {
      font-size: 36px;
    }
    .journal-cta a {
      align-self: center;
      max-width: 100%;
    }
  }
</style>
