---
import type { SocialLinkDto } from '@/entities/social-link';
import { TelegramLink } from './telegram-link';
interface Props {
  preview?: boolean;
  socials: SocialLinkDto[];
  telegramUrl?: string | null;
}
const { socials, telegramUrl } = Astro.props;
const telegram =
  telegramUrl ?? socials.find((item) => item.id === 'telegram')?.url;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="page-container contact-grid">
    <div class="contact-copy">
      <p class="eyebrow" data-cms-copy="eyebrow">Первый шаг</p>
      <h2 id="contact-title" data-cms-copy="title">
        Начнём<br />со знакомства?
      </h2>
      <p class="contact-note">
        До 30 минут · онлайн · бесплатно<br />{' '}Поговорим о твоём запросе и
        поймём,<br />{' '}какой формат тебе подходит.
      </p>
      <div data-cms-react="telegram" style="display:contents">
        <TelegramLink url={telegram} />
      </div>
      {
        !telegram && (
          <p class="fine-print" data-cms-no-telegram>
            Telegram подключим после получения адреса.
          </p>
        )
      }
    </div>
    <div class="contact-form"><slot /></div>
  </div>
</section>
<style>
  .contact {
    background: var(--secondary);
    padding-block: 72px;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 500px;
    gap: 96px;
    align-items: start;
  }
  .contact-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h2 {
    font-size: 72px;
  }
  .contact-note {
    font-size: 17px;
    line-height: 1.7;
  }
  @media (max-width: 1100px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 40px;
    }
    h2 {
      font-size: 60px;
    }
  }
  @media (max-width: 767px) {
    .contact {
      padding-block: 44px;
    }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    h2 {
      font-size: 42px;
    }
    .contact-note {
      font-size: 17px;
    }
    .contact-note br {
      display: none;
    }
  }
</style>
