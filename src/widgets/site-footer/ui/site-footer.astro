---
import type { ContactDetailsDto, SiteSettingsDto } from '@/entities/site';
import { routes } from '@/shared/routes';
interface Props {
  settings: SiteSettingsDto;
  contacts: ContactDetailsDto;
}
const { settings, contacts } = Astro.props;
---

<footer
  class:list={[
    'site-footer',
    Astro.url.pathname === routes.journal && 'journal-footer',
  ]}
>
  <div class="page-container footer-inner">
    <div>
      <a href="/" class="footer-name">{settings.name}</a><p class="fine-print">
        © 2026 · {settings.profession}
      </p>
      {
        (contacts.email || contacts.phone || contacts.address) && (
          <address class="footer-contacts">
            {contacts.email && (
              <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
            )}
            {contacts.phone && (
              <a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}>
                {contacts.phone}
              </a>
            )}
            {contacts.address && <span>{contacts.address}</span>}
          </address>
        )
      }
    </div>
    <nav aria-label="Правовая информация">
      <a href={routes.privacy}>Политика конфиденциальности</a>
      <div>
        <a href={routes.privacy + '#consent'}>Согласие на обработку данных</a
        ><span aria-hidden="true"> · </span><a
          href={routes.coaching + '#formats'}>Условия работы</a
        >
      </div>
    </nav>
  </div>
</footer>
<style>
  .site-footer {
    padding-block: 40px;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .footer-name {
    display: block;
    font-family: var(--font-heading);
    font-size: 30px;
    line-height: 1.06;
    margin-bottom: 6px;
  }
  .footer-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 12px;
    color: var(--muted-foreground);
    font-size: 12px;
    font-style: normal;
  }
  .footer-contacts a:hover {
    text-decoration: underline;
  }
  nav {
    color: var(--muted-foreground);
    font-size: 11px;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  nav a:hover {
    text-decoration: underline;
  }
  @media (max-width: 767px) {
    .site-footer {
      padding-block: 44px;
    }
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .journal-footer {
      padding-block: 36px;
    }
  }
</style>
