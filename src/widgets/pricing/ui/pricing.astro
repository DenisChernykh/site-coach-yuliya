---
import { ServiceCard, type ServiceDto } from '@/entities/service';
import { buttonVariants } from '@/shared/ui';
import { routes } from '@/shared/routes';
import { ArrowUpRight } from 'lucide-react';
interface Props {
  services: ServiceDto[];
}
const { services } = Astro.props;
---

<section id="formats" class="section-space" aria-labelledby="formats-title">
  <div class="page-container pricing-inner">
    <div class="pricing-heading">
      <h2 id="formats-title" class="section-heading" data-cms-copy="title">
        Форматы работы
      </h2>
      <p class="eyebrow format-note" data-cms-copy="eyebrow">
        Индивидуальный коучинг
      </p>
    </div>
    <div class="pricing-grid" data-cms-react="programs">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
    <div class="intro-offer">
      <div>
        <h3>Можно начать с бесплатного знакомства.</h3><p>
          До 30 минут: обсудим запрос и подберём подходящий формат.
        </p>
      </div>
      <a
        href="#contact"
        class:list={[buttonVariants(), 'h-14 px-6 gap-[18px] text-sm']}
        >Бесплатно познакомиться <ArrowUpRight
          size={18}
          aria-hidden="true"
        /></a
      >
    </div>
    <p class="fine-print">
      Оплата до начала работы. Условия переноса и отмены согласуем заранее. Цены
      из задания — подтвердить перед публикацией.
      <a href={routes.terms} class="underline underline-offset-2"
        >Условия работы, отмены и возврата</a
      >.
    </p>
  </div>
</section>
<style>
  .pricing-inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .pricing-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
  }
  .format-note {
    font-size: 14px;
    line-height: 1.5;
    flex-shrink: 0;
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }
  .intro-offer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    border-top: 1px solid var(--border);
    padding-top: 28px;
  }
  .intro-offer h3 {
    font-size: 30px;
  }
  .intro-offer p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted-foreground);
  }
  @media (max-width: 1100px) {
    .pricing-heading {
      gap: 30px;
    }
  }
  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
    .pricing-heading,
    .intro-offer {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
  }
  @media (max-width: 767px) {
    .pricing-inner {
      gap: 28px;
    }
    .pricing-grid {
      gap: 24px;
    }
    .intro-offer h3 {
      font-size: 30px;
    }
    .intro-offer a {
      max-width: 100%;
    }
  }
</style>
