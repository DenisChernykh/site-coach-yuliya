---
import { ServiceCard, type ServiceDto } from '@/entities/service';
import { buttonVariants } from '@/shared/ui';
import { ArrowUpRight } from 'lucide-react';
interface Props {
  services: ServiceDto[];
}
const { services } = Astro.props;
---

<section id="formats" class="section-space" aria-labelledby="formats-title">
  <div class="page-container pricing-inner">
    <aside class="intro-offer" aria-labelledby="intro-offer-title">
      <div class="intro-copy">
        <p class="intro-details">30–60 минут · по видеосвязи</p>
        <h2 id="intro-offer-title">Бесплатная встреча</h2>
        <p class="intro-description">
          Расскажи, что сейчас не устраивает. Вместе уточним запрос и наметим
          темы для дальнейшей работы.
        </p>
      </div>
      <div class="intro-action">
        <a
          href="#contact"
          class:list={[buttonVariants(), 'h-14 px-6 gap-[18px] text-sm']}
          >Записаться бесплатно <ArrowUpRight size={18} aria-hidden="true" /></a
        >
        <p>Можно прийти без готового запроса.</p>
      </div>
    </aside>
    <div class="pricing-heading">
      <h2 id="formats-title" class="section-heading" data-cms-copy="title">
        Форматы работы
      </h2>
      <p class="eyebrow format-note" data-cms-copy="eyebrow">
        Индивидуальный коучинг
      </p>
    </div>
    <div class="pricing-grid" data-cms-react="programs">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </div>
</section>
<style>
  .pricing-inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .pricing-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
  }
  .format-note {
    font-size: 14px;
    line-height: 1.5;
    flex-shrink: 0;
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }
  .intro-offer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 48px;
    padding: 40px;
    margin-bottom: 16px;
    background: var(--accent);
    color: var(--accent-foreground);
    border-radius: var(--radius);
  }
  .intro-details {
    font-size: 14px;
    line-height: 1.5;
  }
  .intro-offer h2 {
    margin-top: 14px;
    font-size: 48px;
  }
  .intro-description {
    max-width: 520px;
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.65;
  }
  .intro-action {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .intro-action p {
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }
  @media (max-width: 1100px) {
    .pricing-heading {
      gap: 30px;
    }
  }
  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
    .pricing-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .intro-offer {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .intro-action {
      align-items: flex-start;
    }
  }
  @media (max-width: 767px) {
    .pricing-inner {
      gap: 28px;
    }
    .pricing-grid {
      gap: 24px;
    }
    .intro-offer {
      padding: 28px 24px;
      margin-bottom: 8px;
    }
    .intro-offer h2 {
      font-size: 38px;
    }
    .intro-offer a {
      max-width: 100%;
    }
  }
</style>
