---
import type { SiteSettingsDto } from '@/entities/site';
import { MobileNavigation } from '@/features/mobile-navigation';
import { routes } from '@/shared/routes';
import { buttonVariants } from '@/shared/ui';
import { ArrowUpRight } from 'lucide-react';

interface Props {
  settings: SiteSettingsDto;
}
const { settings } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="page-container header-inner">
    <a
      href={routes.home}
      class="brand"
      aria-label={`${settings.name} — главная`}
    >
      <span>{settings.name}</span>
      <small>{settings.profession}</small>
    </a>
    <nav class="desktop-navigation" aria-label="Основная навигация">
      {
        settings.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={item.href === pathname ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href={routes.contact} class:list={[buttonVariants(), 'header-cta']}
      >Давай познакомимся <ArrowUpRight size={18} aria-hidden="true" /></a
    >
    <div class="mobile-navigation">
      <MobileNavigation
        client:load
        navigation={settings.navigation}
        name={settings.name}
      />
    </div>
  </div>
  <noscript
    ><nav class="no-js-navigation" aria-label="Навигация">
      {settings.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav></noscript
  >
</header>
<style>
  .site-header {
    height: 100px;
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 100%;
  }
  .brand {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    gap: 0;
  }
  .brand span {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.15;
  }
  .brand small {
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 1.3px;
    text-transform: uppercase;
  }
  .desktop-navigation {
    display: flex;
    gap: 32px;
    font-size: 13px;
    line-height: 1.5;
  }
  .desktop-navigation a {
    padding-block: 8px;
  }
  .desktop-navigation a:hover,
  .desktop-navigation a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .header-cta {
    height: 44px;
    padding-inline: 24px;
    gap: 18px;
    font-size: 14px;
  }
  .mobile-navigation {
    display: none;
  }
  .no-js-navigation {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    padding: 12px;
    background: var(--background);
  }
  @media (max-width: 1050px) {
    .desktop-navigation,
    .header-cta {
      display: none;
    }
    .mobile-navigation {
      display: block;
    }
  }
  @media (max-width: 767px) {
    .site-header {
      height: 80px;
    }
    .brand span {
      font-size: 22px;
    }
    .brand small {
      max-width: 235px;
      font-size: 7px;
    }
  }
</style>
