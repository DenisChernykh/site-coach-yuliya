---
interface Props {
  embedded?: boolean;
}
const { embedded = false } = Astro.props;
const Tag = embedded ? 'div' : 'section';
const Heading = embedded ? 'h3' : 'h2';
---

<Tag
  class:list={['boundaries', { embedded }]}
  aria-labelledby="boundaries-title"
>
  <div class:list={['boundaries-grid', !embedded && 'page-container']}>
    <Heading id="boundaries-title"
      >Конфиденциальность и границы коучинга</Heading
    >
    <div>
      <p class="boundaries-intro">
        Конфиденциально. Без оценок и готовых советов.
      </p>
      <p>
        Ты решаешь, чем готова поделиться. Мы обсуждаем твою ситуацию и варианты
        действий. Коучинг не заменяет психотерапию; если запрос выходит за мои
        компетенции, я предложу обратиться к профильному специалисту.
      </p>
    </div>
  </div>
</Tag>
<style>
  .boundaries {
    background: var(--secondary);
    padding-block: 48px;
  }
  .boundaries-grid {
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: 80px;
  }
  h2 {
    font-size: 46px;
  }
  h3 {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
  }
  p {
    font-size: 15px;
    line-height: 1.65;
  }
  .boundaries-intro {
    font-size: 17px;
    margin-bottom: 12px;
  }
  .embedded {
    grid-column: 1 / -1;
    border-top: 1px solid currentColor;
    background: transparent;
    padding: 36px 0 0;
  }
  .embedded .boundaries-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
  }
  @media (max-width: 1100px) {
    .boundaries-grid {
      grid-template-columns: 1fr 1.7fr;
      gap: 40px;
    }
  }
  @media (max-width: 767px) {
    .boundaries {
      padding-block: 44px;
    }
    .boundaries-grid,
    .embedded .boundaries-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .embedded {
      padding: 28px 0 0;
    }
    h2 {
      font-size: 38px;
    }
  }
</style>
