---
import type { StepDto } from '@/entities/site';
interface Props {
  steps: StepDto[];
}
const { steps } = Astro.props;
---

<section class="process" aria-labelledby="process-title">
  <div class="page-container">
    <h2 id="process-title" data-cms-copy="title">Как проходит работа</h2>
    <ol class="process-grid" data-cms-list="home.process">
      {
        steps.map((step, index) => (
          <li data-cms-item>
            <>
              <span class="step-number" data-cms-index>
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 data-cms-field=".title">{step.title}</h3>
              <p data-cms-field=".description">{step.description}</p>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</section>
<style>
  .process {
    padding-block: 64px 72px;
  }
  h2 {
    font-size: 50px;
  }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .step-number {
    display: block;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted-foreground);
  }
  h3 {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 500;
    margin-top: 12px;
    line-height: 1.5;
  }
  li p {
    font-size: 14px;
    line-height: 1.5;
    white-space: pre-line;
    color: var(--muted-foreground);
    margin-top: 12px;
  }
  @media (max-width: 900px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .process {
      padding-block: 44px;
    }
    h2 {
      font-size: 42px;
    }
    .process-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 28px;
    }
    li p {
      white-space: normal;
    }
  }
</style>
