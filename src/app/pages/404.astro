---
import BaseLayout from '../layouts/base-layout.astro';
import { loadSiteSettings } from '@/entities/site';
import { buttonVariants } from '@/shared/ui';
const settings = await loadSiteSettings();
---

<BaseLayout settings={settings} title="Страница не найдена — Юля Валишина">
  <section class="page-container py-24">
    <p class="eyebrow">404</p><h1 class="mt-5 text-5xl">
      Здесь пока нет страницы.
    </h1>
    <a href="/" class:list={[buttonVariants(), 'mt-8 h-12 px-6']}
      >На главную ↗</a
    >
  </section>
</BaseLayout>
