---
import { loadPageLayouts } from '@/entities/cms';
const layouts = await loadPageLayouts();
import BaseLayout from '../layouts/base-layout.astro';
import { StoriesIsland } from '../islands/stories-island';
import { isMockMode } from '@/shared/api';
import { resolveArticleImages } from '../data/article-images';
import { HomePage } from '@/pages/home';
import { loadHomePage, loadSiteSettings, loadContacts } from '@/entities/site';
import { loadServices } from '@/entities/service';
import { loadFaq } from '@/entities/faq';
import { loadSocialLinks } from '@/entities/social-link';
import { loadArticles } from '@/entities/article';
const [settings, home, services, faq, contacts, socials, rawArticles] =
  await Promise.all([
    loadSiteSettings(),
    loadHomePage(),
    loadServices(),
    loadFaq(),
    loadContacts(),
    loadSocialLinks(),
    loadArticles(),
  ]);
const articles = await resolveArticleImages(rawArticles, 960);
const storiesBlock = layouts
  .find((page) => page.key === 'home')
  ?.blocks.find((block) => block.id === 'stories');
---

<BaseLayout
  services={services}
  settings={settings}
  socials={socials}
  seoPage="home"
>
  <HomePage
    layouts={layouts}
    data={home}
    telegramUrl={contacts.telegramUrl}
    services={services}
    faq={faq}
    socials={socials}
    articles={articles}
  >
    <StoriesIsland
      slot="stories"
      client:load
      demoStories={isMockMode ? home.stories : undefined}
      title={storiesBlock?.title}
      eyebrow={storiesBlock?.eyebrow}
    />
  </HomePage>
</BaseLayout>
