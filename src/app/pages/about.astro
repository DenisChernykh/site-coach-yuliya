---
import { loadPageLayouts } from '@/entities/cms';
const layouts = await loadPageLayouts();
import BaseLayout from '../layouts/base-layout.astro';
import { AboutPage } from '@/pages/about';
import { loadHomePage, loadSiteSettings } from '@/entities/site';
const [settings, data] = await Promise.all([
  loadSiteSettings(),
  loadHomePage(),
]);
---

<BaseLayout settings={settings} seoPage="about">
  <AboutPage layouts={layouts} data={data} />
</BaseLayout>
