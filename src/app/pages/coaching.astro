---
import { loadPageLayouts } from '@/entities/cms';
const layouts = await loadPageLayouts();
import BaseLayout from '../layouts/base-layout.astro';
import { ConsultationIsland } from '../islands/consultation-island';
import { CoachingPage } from '@/pages/coaching';
import { loadHomePage, loadSiteSettings, loadContacts } from '@/entities/site';
import { loadServices } from '@/entities/service';
import { loadFaq } from '@/entities/faq';
import { loadSocialLinks } from '@/entities/social-link';
const [settings, home, services, faq, contacts, socials] = await Promise.all([
  loadSiteSettings(),
  loadHomePage(),
  loadServices(),
  loadFaq(),
  loadContacts(),
  loadSocialLinks(),
]);
---

<BaseLayout settings={settings} socials={socials} seoPage="coaching">
  <CoachingPage
    layouts={layouts}
    data={home}
    telegramUrl={contacts.telegramUrl}
    services={services}
    faq={faq}
    socials={socials}
  >
    <ConsultationIsland
      slot="contact-form"
      client:load
      services={services}
      source="COACHING_CONTACT"
    />
  </CoachingPage>
</BaseLayout>
