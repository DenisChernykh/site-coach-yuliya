---
import { loadPageLayouts } from '@/entities/cms';
const layouts = await loadPageLayouts();
import BaseLayout from '../layouts/base-layout.astro';
import { ConsultationIsland } from '../islands/consultation-island';
import { CoachingPage } from '@/pages/coaching';
import { loadHomePage, loadSiteSettings } from '@/entities/site';
import { loadServices } from '@/entities/service';
import { loadFaq } from '@/entities/faq';
import { loadSocialLinks } from '@/entities/social-link';
const [settings, home, services, faq, socials] = await Promise.all([
  loadSiteSettings(),
  loadHomePage(),
  loadServices(),
  loadFaq(),
  loadSocialLinks(),
]);
---

<BaseLayout
  settings={settings}
  socials={socials}
  title="Индивидуальный коучинг — Юля Валишина"
>
  <CoachingPage
    layouts={layouts}
    data={home}
    services={services}
    faq={faq}
    socials={socials}
  >
    <ConsultationIsland slot="contact-form" client:load services={services} />
  </CoachingPage>
</BaseLayout>
