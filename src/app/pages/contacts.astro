---
import { loadPageLayouts } from '@/entities/cms';
const layouts = await loadPageLayouts();
import BaseLayout from '../layouts/base-layout.astro';
import { ConsultationIsland } from '../islands/consultation-island';
import { ContactsPage } from '@/pages/contacts';
import { loadContacts, loadSiteSettings } from '@/entities/site';
import { loadSocialLinks } from '@/entities/social-link';
import { loadServices } from '@/entities/service';
import { loadFaq } from '@/entities/faq';
const [settings, contacts, socials, services, faq] = await Promise.all([
  loadSiteSettings(),
  loadContacts(),
  loadSocialLinks(),
  loadServices(),
  loadFaq(),
]);
---

<BaseLayout
  settings={settings}
  contacts={contacts}
  socials={socials}
  seoPage="contacts"
>
  <ContactsPage
    layouts={layouts}
    contacts={contacts}
    socials={socials}
    faq={faq}
  >
    <ConsultationIsland
      slot="contact-form"
      client:load
      services={services}
      source="CONTACTS_CONTACT"
    />
  </ContactsPage>
</BaseLayout>
