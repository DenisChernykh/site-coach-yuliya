# mock: deterministic local content; api: content from the NestJS backend.
PUBLIC_DATA_SOURCE=mock
# Required in api mode. Example: http://localhost:3000
PUBLIC_API_BASE_URL=
# Optional server-only API origin for local rendering behind a tunnel.
API_INTERNAL_BASE_URL=
# URL or absolute path to the Swagger/OpenAPI export from NestJS; used by api:sync.
OPENAPI_SPEC_SOURCE=
# Optional static hosting origin and subpath (local/NetAngels default: /).
PUBLIC_SITE_URL=
PUBLIC_SITE_BASE=/

# Production error reporting. The public DSN is an ingestion address, not an API token.
# Use the same Sentry project for site, admin and backend. Leave blank in local/demo builds.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_RELEASE=
