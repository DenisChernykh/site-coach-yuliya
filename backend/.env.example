NODE_ENV=development
LOG_LEVEL=info
# Production collector URL and a private server ingestion key.
MONITOR_URL=
MONITOR_KEY=
OTEL_SERVICE_NAME=coach-yuliya
OTEL_SDK_DISABLED=true
API_HOST=127.0.0.1
API_PORT=3000
API_DOCS_MODE=public
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:5173
ADMIN_STATIC_DIR=
TRUST_PROXY_CIDRS=
DATABASE_URL=postgresql://coach_yuliya:local-development-only@127.0.0.1:55438/coach_yuliya?schema=public
DATABASE_POOL_MAX=5
# setup:local generates four independent secrets and saves them in ignored .env.
AUTH_SESSION_KEY_SECRET=
AUTH_CSRF_SECRET=
AUTH_RATE_LIMIT_KEY_SECRET=
AUTH_NETWORK_METADATA_SECRET=
AUTH_SELF_SERVICE_MODE=disabled
AUTH_ACCOUNT_ADMINISTRATION_MODE=disabled
AUTH_ACCOUNT_EMAIL_WORKFLOWS_MODE=disabled
TELEGRAM_NOTIFICATIONS_MODE=disabled
# To send real messages, set enabled and supply both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_REBUILD_MODE=disabled
GITHUB_REPOSITORY=
GITHUB_PUBLICATION_REF=
GITHUB_ACTIONS_TOKEN=
PUBLIC_SITE_URL=

# Optional inherited full Compose environment; the lightweight local setup uses compose.local.yml.
POSTGRES_DB=coach_yuliya
POSTGRES_USER=coach_yuliya
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55438
