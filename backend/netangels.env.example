# Save outside releases as app/shared/.env with chmod 600.
NODE_ENV=production
LOG_LEVEL=info
OTEL_SERVICE_NAME=coach-yuliya
OTEL_SDK_DISABLED=true
# Collector URL and private server key. Never use the public browser key here.
MONITOR_URL=
MONITOR_KEY=
API_DOCS_MODE=protected
PUBLIC_API_URL=https://api.example.ru
CORS_ORIGINS=https://example.ru,https://api.example.ru
# Exact proxy addresses from NetAngels support/panel; do not use a wildcard.
TRUST_PROXY_CIDRS=
# Either set DATABASE_URL from the panel or use DB_CONNECTION_STRING supplied by hosting.
DATABASE_POOL_MAX=5
MEDIA_DIRECTORY=/home/cXXXX/api.example.ru/app/shared/media
# Generate each independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_KEY_SECRET=
AUTH_CSRF_SECRET=
AUTH_RATE_LIMIT_KEY_SECRET=
AUTH_NETWORK_METADATA_SECRET=
AUTH_SELF_SERVICE_MODE=disabled
AUTH_ACCOUNT_ADMINISTRATION_MODE=disabled
AUTH_ACCOUNT_EMAIL_WORKFLOWS_MODE=disabled
TELEGRAM_NOTIFICATIONS_MODE=enabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_REBUILD_MODE=enabled
PUBLIC_SITE_URL=https://example.ru
GITHUB_REPOSITORY=owner/repository
GITHUB_PUBLICATION_REF=main
# Fine-grained token for this repository with Actions: write.
GITHUB_ACTIONS_TOKEN=
